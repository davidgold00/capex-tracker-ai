      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m",
        "capex_tracker",
        "readme"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONPATH": "${workspaceFolder}/src"
        }
      },
      "problemMatcher": []
