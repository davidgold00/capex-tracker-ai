      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONPATH": "${workspaceFolder}/src"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Guidance: run grounding demo",
      "type": "process",
      "command": "${command:python.interpreterPath}",
