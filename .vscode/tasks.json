{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Guidance: apply saved CSV decisions",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m",
        "capex_tracker.guidance.review"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONPATH": "${workspaceFolder}/src"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Guidance: cache SEC source documents",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m",
        "capex_tracker.guidance.sources"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONPATH": "${workspaceFolder}/src"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Guidance: run interview demo",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m",
        "capex_tracker.guidance.demo",
