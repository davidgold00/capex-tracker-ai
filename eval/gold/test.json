[
  {
    "company": "AMZN",
    "accession": "0001018724-25-000004",
    "filed": "2025-02-07",
    "form": "10-K",
    "text": "We expect cash capital expenditures to increase in 2025, primarily driven by investments in technology infrastructure.",
    "id": "gold-b640bd85b5",
    "source_url": "https://www.sec.gov/Archives/edgar/data/1018724/000101872425000004/amzn-20241231.htm",
    "kind": "directional",
    "year": 2025,
    "low": null,
    "high": null,
    "direction": "up",
    "uncertain": null
  },
  {
    "company": "AMZN",
    "accession": "0001018724-26-000002",
    "filed": "2026-02-05",
    "form": "8-K",
    "text": "\u201cWith such strong demand for our existing offerings and seminal opportunities like AI, chips, robotics, and low earth orbit satellites, we expect to invest about $200 billion in capital expenditures across Amazon in 2026, and anticipate strong long-term return on invested capital.\u201d",
    "id": "gold-8b1565ec4c",
    "source_url": "https://www.sec.gov/Archives/edgar/data/1018724/000101872426000002/amzn-20251231xex991.htm",
    "kind": "numeric_point",
    "year": 2026,
    "low": 200000000000,
    "high": 200000000000,
    "direction": null,
    "uncertain": null
  },
  {
    "company": "AMZN",
    "accession": "0001018724-26-000038",
    "filed": "2026-10-29",
    "form": "8-K",
    "text": "\u2022We continue to expect 2026 cash capital expenditures to be approximately $220 billion.",
    "id": "gold-e662cc2339",
    "source_url": "https://www.sec.gov/Archives/edgar/data/1018724/000101872426000038/amzn-20260930xex991.htm",
    "kind": "numeric_point",
    "year": 2026,
    "low": 220000000000,
    "high": 220000000000,
    "direction": null,
    "uncertain": null
  },
  {
    "company": "AMZN",
    "accession": "0001018724-26-000038",
    "filed": "2026-10-29",
    "form": "8-K",
    "text": "We expect year-over-year advertising revenue to grow in the high teens in fourth quarter 2026.",
    "id": "gold-249d360ba3",
    "source_url": "https://www.sec.gov/Archives/edgar/data/1018724/000101872426000038/amzn-20260930xex991.htm",
    "kind": "none",
    "year": null,
    "low": null,
    "high": null,
    "direction": null,
    "uncertain": null
  },
  {
    "company": "AMZN",
    "accession": "0001018724-26-000040",
    "filed": "2026-10-30",
    "form": "10-Q",
    "text": "We expect cash capital expenditures to meaningfully increase in 2027, primarily driven by investments in technology infrastructure.",
    "id": "gold-8deeb3de40",
    "source_url": "https://www.sec.gov/Archives/edgar/data/1018724/000101872426000040/amzn-20260930.htm",
    "kind": "directional",
    "year": 2027,
    "low": null,
    "high": null,
    "direction": "up",
    "uncertain": null
  },
  {
    "company": "GOOGL",
    "accession": "0001652044-25-000010",
    "filed": "2025-02-04",
    "form": "8-K",
    "text": "We are confident about the opportunities ahead, and to accelerate our progress, we expect to invest approximately $75 billion in capital expenditures in 2025.\u201d",
    "id": "gold-c6a7359c9c",
    "source_url": "https://www.sec.gov/Archives/edgar/data/1652044/000165204425000010/googexhibit991q42024.htm",
    "kind": "numeric_point",
    "year": 2025,
    "low": 75000000000,
    "high": 75000000000,
    "direction": null,
    "uncertain": null
  },
  {
    "company": "GOOGL",
    "accession": "0001652044-25-000043",
    "filed": "2025-04-25",
    "form": "10-Q",
    "text": "\u2022Capital expenditures, which primarily reflected investments in technical infrastructure, were $17.2 billion for the three months ended March 31, 2025.",
    "id": "gold-823f45cc93",
    "source_url": "https://www.sec.gov/Archives/edgar/data/1652044/000165204425000043/goog-20250331.htm",
    "kind": "none",
    "year": null,
    "low": null,
    "high": null,
    "direction": null,
    "uncertain": null
  },
  {
    "company": "GOOGL",
    "accession": "0001652044-25-000056",
    "filed": "2025-07-23",
    "form": "8-K",
    "text": "With this strong and growing demand for our Cloud products and services, we are increasing our investment in capital expenditures in 2025 to approximately $85 billion and are excited by the opportunity ahead.\u201d",
    "id": "gold-ed8617ced7",
    "source_url": "https://www.sec.gov/Archives/edgar/data/1652044/000165204425000056/googexhibit991q22025.htm",
    "kind": "numeric_point",
    "year": 2025,
    "low": 85000000000,
    "high": 85000000000,
    "direction": null,
    "uncertain": null
  },
  {
    "company": "GOOGL",
    "accession": "0001652044-25-000087",
    "filed": "2025-10-29",
    "form": "8-K",
    "text": "\u2022With the growth across our business and demand from Cloud customers, we now expect 2025 capital expenditures to be in a range of $91 billion to $93 billion.",
    "id": "gold-6fdb267a93",
    "source_url": "https://www.sec.gov/Archives/edgar/data/1652044/000165204425000087/googexhibit991q32025.htm",
    "kind": "numeric_range",
    "year": 2025,
    "low": 91000000000,
    "high": 93000000000,
    "direction": null,
    "uncertain": null
  },
  {
    "company": "GOOGL",
    "accession": "0001652044-25-000091",
    "filed": "2025-10-30",
    "form": "10-Q",
    "text": "We expect full year 2025 capital expenditures to exceed full year 2024.",
    "id": "gold-7725c52104",
    "source_url": "https://www.sec.gov/Archives/edgar/data/1652044/000165204425000091/goog-20250930.htm",
    "kind": "directional",
    "year": 2025,
    "low": null,
    "high": null,
    "direction": "up",
    "uncertain": null
  },
  {
    "company": "GOOGL",
    "accession": "0001652044-26-000012",
    "filed": "2026-02-04",
    "form": "8-K",
    "text": "To meet customer demand and capitalize on the growing opportunities we have ahead of us, our 2026 CapEx investments are anticipated to be in the range of $175 to $185 billion.\u201d",
    "id": "gold-1c68affd48",
    "source_url": "https://www.sec.gov/Archives/edgar/data/1652044/000165204426000012/googexhibit991q42025.htm",
    "kind": "numeric_range",
    "year": 2026,
    "low": 175000000000,
    "high": 185000000000,
    "direction": null,
    "uncertain": null
  },
  {
    "company": "GOOGL",
    "accession": "0001652044-26-000018",
    "filed": "2026-02-05",
    "form": "10-K",
    "text": "We invested heavily in capital expenditures in 2025 and in 2026, we expect to significantly increase, relative to 2025, our investment in our technical infrastructure, including servers and network equipment, and data centers.",
    "id": "gold-f3331e409d",
    "source_url": "https://www.sec.gov/Archives/edgar/data/1652044/000165204426000018/goog-20251231.htm",
    "kind": "none",
    "year": null,
    "low": null,
    "high": null,
    "direction": null,
    "uncertain": "Infrastructure spending is a subset of total capex."
  },
  {
    "company": "GOOGL",
    "accession": "0001652044-26-000048",
    "filed": "2026-04-30",
    "form": "10-Q",
    "text": "We expect to begin recognizing revenues from these agreements later in 2026, with the significant majority to be recognized in 2027.",
    "id": "gold-924bf9d00b",
    "source_url": "https://www.sec.gov/Archives/edgar/data/1652044/000165204426000048/goog-20260331.htm",
    "kind": "none",
    "year": null,
    "low": null,
    "high": null,
    "direction": null,
    "uncertain": null
  },
  {
    "company": "GOOGL",
    "accession": "0001652044-26-000071",
    "filed": "2026-07-23",
    "form": "10-Q",
    "text": "The net proceeds received by the company were $20.5 billion which will be used for general corporate purposes, including capital expenditures to scale AI infrastructure and global compute.",
    "id": "gold-0b26acf1cd",
    "source_url": "https://www.sec.gov/Archives/edgar/data/1652044/000165204426000071/goog-20260630.htm",
    "kind": "none",
    "year": null,
    "low": null,
    "high": null,
    "direction": null,
    "uncertain": null
  },
  {
    "company": "META",
    "accession": "0001326801-25-000014",
    "filed": "2025-01-29",
    "form": "8-K",
    "text": "The majority of our capital expenditures in 2025 will continue to be directed to our core business.",
    "id": "gold-57ea0abc9b",
    "source_url": "https://www.sec.gov/Archives/edgar/data/1326801/000132680125000014/meta-12312024xexhibit991.htm",
    "kind": "none",
    "year": null,
    "low": null,
    "high": null,
    "direction": null,
    "uncertain": null
  },
  {
    "company": "META",
    "accession": "0001628280-25-047114",
    "filed": "2025-10-29",
    "form": "8-K",
    "text": "We anticipate this will provide further upward pressure on our capital expenditures and expense plans next year.",
    "id": "gold-5ec564046c",
    "source_url": "https://www.sec.gov/Archives/edgar/data/1326801/000162828025047114/meta-09302025xexhibit991.htm",
    "kind": "none",
    "year": null,
    "low": null,
    "high": null,
    "direction": null,
    "uncertain": "Pressure on plans may not constitute a revised forecast."
  },
  {
    "company": "META",
    "accession": "0001628280-25-047114",
    "filed": "2025-10-29",
    "form": "8-K",
    "text": "We expect fourth quarter 2025 total revenue to be in the range of $56-59 billion.",
    "id": "gold-409d7dda32",
    "source_url": "https://www.sec.gov/Archives/edgar/data/1326801/000162828025047114/meta-09302025xexhibit991.htm",
    "kind": "none",
    "year": null,
    "low": null,
    "high": null,
    "direction": null,
    "uncertain": null
  },
  {
    "company": "META",
    "accession": "0001628280-26-003832",
    "filed": "2026-01-28",
    "form": "8-K",
    "text": "We anticipate 2026 capital expenditures, including principal payments on finance leases, to be in the range of $115-135 billion, with year-over-year growth driven by increased investment to support our Meta Superintelligence Labs efforts and core business.",
    "id": "gold-e058ea7717",
    "source_url": "https://www.sec.gov/Archives/edgar/data/1326801/000162828026003832/meta-12312025xexhibit991.htm",
    "kind": "numeric_range",
    "year": 2026,
    "low": 115000000000,
    "high": 135000000000,
    "direction": null,
    "uncertain": null
  },
  {
    "company": "META",
    "accession": "0001628280-26-028364",
    "filed": "2026-04-29",
    "form": "8-K",
    "text": "We anticipate 2026 capital expenditures, including principal payments on finance leases, to be in the range of $125-145 billion, increased from our prior range of $115-135 billion.",
    "id": "gold-c37db8398c",
    "source_url": "https://www.sec.gov/Archives/edgar/data/1326801/000162828026028364/meta-03312026xexhibit991.htm",
    "kind": "numeric_range",
    "year": 2026,
    "low": 125000000000,
    "high": 145000000000,
    "direction": null,
    "uncertain": null
  },
  {
    "company": "MSFT",
    "accession": "0001193125-25-256321",
    "filed": "2025-10-29",
    "form": "10-Q",
    "text": "We will continue to invest in capital expenditures to support growth in our cloud offerings and our investments in AI infrastructure and training.",
    "id": "gold-007aa73857",
    "source_url": "https://www.sec.gov/Archives/edgar/data/789019/000119312525256321/msft-20250930.htm",
    "kind": "none",
    "year": null,
    "low": null,
    "high": null,
    "direction": null,
    "uncertain": null
  },
  {
    "company": "ORCL",
    "accession": "0001193125-26-100148",
    "filed": "2026-03-10",
    "form": "8-K",
    "text": "For fiscal year 2026, we expect revenue of $67 billion and capital expenditures of $50 billion.",
    "id": "gold-5bb39b55eb",
    "source_url": "https://www.sec.gov/Archives/edgar/data/1341439/000119312526100148/orcl-ex99_1.htm",
    "kind": "numeric_point",
    "year": 2026,
    "low": 50000000000,
    "high": 50000000000,
    "direction": null,
    "uncertain": null
  },
  {
    "company": "ORCL",
    "accession": "0001193125-26-265848",
    "filed": "2026-06-10",
    "form": "8-K",
    "text": "Total Revenues are expected to grow from 27% to 29% in both constant currency and USD.",
    "id": "gold-f311c4be9d",
    "source_url": "https://www.sec.gov/Archives/edgar/data/1341439/000119312526265848/orcl-ex99_1.htm",
    "kind": "none",
    "year": null,
    "low": null,
    "high": null,
    "direction": null,
    "uncertain": null
  },
  {
    "company": "ORCL",
    "accession": "0001193125-26-277521",
    "filed": "2026-06-22",
    "form": "10-K",
    "text": "Net cash used for investing activities increased by $30.1 billion in fiscal 2026 relative to fiscal 2025 primarily due to a $34.4 billion increase in capital expenditures, partially offset by $4.3 billion of cash proceeds from the sale of our investment in Ampere.",
    "id": "gold-04e9b0f5b2",
    "source_url": "https://www.sec.gov/Archives/edgar/data/1341439/000119312526277521/orcl-20260531.htm",
    "kind": "none",
    "year": null,
    "low": null,
    "high": null,
    "direction": null,
    "uncertain": null
  },
  {
    "company": "ORCL",
    "accession": "0001193125-26-389274",
    "filed": "2026-09-11",
    "form": "10-Q",
    "text": "We expect our capital expenditures in fiscal 2027 to be higher than fiscal 2026 as we increase our existing data center capacity and establish data centers in new geographic locations in order to meet current and expected customer demand for our cloud offerings.",
    "id": "gold-240e4f75c3",
    "source_url": "https://www.sec.gov/Archives/edgar/data/1341439/000119312526389274/orcl-20260831.htm",
    "kind": "directional",
    "year": 2027,
    "low": null,
    "high": null,
    "direction": "up",
    "uncertain": null
  }
]
